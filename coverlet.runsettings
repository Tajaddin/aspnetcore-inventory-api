<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Exclude auto-generated EF migrations and the bootstrap entrypoint
               from the coverage gate; they are not unit-testable logic. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <Exclude>[InventoryApi]InventoryApi.Migrations.*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
